{
  "name": "docs-smart",
  "version": "0.1.0",
  "private": true,
  "description": "Smart MCP for Google Docs (read + write), single-account, wraps ~/.santo-agent OAuth token jar.",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./render": { "types": "./dist/render.d.ts", "import": "./dist/render.js" }
  },
  "bin": {
    "docs-smart": "dist/server.js",
    "docs-smart-auth": "dist/bin/docs-smart-auth.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js dist/bin/docs-smart-auth.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "timeout 3 node dist/server.js < /dev/null"
  },
  "dependencies": {
    "smart-mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "msw": "^2.6.0",
    "@types/node": "^22.0.0"
  }
}
