{
  "name": "email-smart",
  "version": "0.1.0",
  "private": true,
  "description": "Smart MCP for Gmail send + inbox read + reversible bulk modify, multi-account, wraps ~/.santo-agent OAuth token jar.",
  "type": "module",
  "main": "dist/server.js",
  "bin": { "email-smart": "dist/server.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "node dist/server.js < /dev/null || true"
  },
  "dependencies": {
    "smart-mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "msw": "^2.6.0",
    "@types/node": "^22.0.0"
  }
}
