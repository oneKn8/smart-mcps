{
  "name": "flow-smart",
  "version": "0.1.0",
  "private": true,
  "description": "Smart MCP orchestrator: cross-app flows over tasks, docs, apps-script, calendar, and email clients.",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": { "types": "./dist/server.d.ts", "import": "./dist/server.js" }
  },
  "bin": {
    "flow-smart": "dist/server.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json && chmod +x dist/server.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "timeout 3 node dist/server.js < /dev/null"
  },
  "dependencies": {
    "smart-mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "tasks-smart": "*",
    "docs-smart": "*",
    "apps-script-smart": "*",
    "calendar-smart": "*",
    "email-smart": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "msw": "^2.6.0",
    "@types/node": "^22.0.0"
  }
}
