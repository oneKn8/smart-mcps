{
  "name": "vercel-smart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": { "vercel-smart": "dist/server.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
